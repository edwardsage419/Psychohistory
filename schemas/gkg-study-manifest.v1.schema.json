{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "gkg-study-manifest v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "study_id": {
      "type": "string",
      "minLength": 1
    },
    "batches": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "batch_id": {
            "type": "string",
            "pattern": "^[0-9]{14}$"
          },
          "cohort": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "batch_id",
          "cohort",
          "url"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "study_id",
    "batches"
  ],
  "additionalProperties": false
}
