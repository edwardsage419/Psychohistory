{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source-independent IndicatorDefinition v1",
  "type": "object",
  "properties": {
    "indicator_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "source_family": {
      "type": "string",
      "minLength": 1
    },
    "source_dataset": {
      "type": "string",
      "minLength": 1
    },
    "source_field": {
      "type": "string",
      "minLength": 1
    },
    "unit": {
      "type": "string",
      "minLength": 1
    },
    "temporal_granularity": {
      "type": "string",
      "minLength": 1
    },
    "geographic_scope": {
      "type": "string",
      "minLength": 1
    },
    "entity_scope": {
      "type": "string",
      "minLength": 1
    },
    "normalization_method": {
      "type": "string",
      "minLength": 1
    },
    "denominator": {
      "type": "string",
      "minLength": 1
    },
    "aggregation_method": {
      "type": "string",
      "minLength": 1
    },
    "missing_data_policy": {
      "type": "string",
      "minLength": 1
    },
    "duplicate_policy": {
      "type": "string",
      "minLength": 1
    },
    "smoothing_policy": {
      "type": "string",
      "minLength": 1
    },
    "lag_policy": {
      "type": "string",
      "minLength": 1
    },
    "semantic_interpretation": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "experimental",
        "validated",
        "deprecated",
        "rejected"
      ]
    },
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "quality_requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "known_biases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "provenance_requirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "documentation": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "transformation": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "method",
        "version",
        "parameters"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "indicator_id",
    "version",
    "title",
    "description",
    "source_family",
    "source_dataset",
    "source_field",
    "unit",
    "temporal_granularity",
    "geographic_scope",
    "entity_scope",
    "normalization_method",
    "denominator",
    "aggregation_method",
    "missing_data_policy",
    "duplicate_policy",
    "smoothing_policy",
    "lag_policy",
    "semantic_interpretation",
    "status",
    "schema_version",
    "quality_requirements",
    "known_biases",
    "limitations",
    "provenance_requirements",
    "documentation",
    "transformation"
  ],
  "additionalProperties": false
}
