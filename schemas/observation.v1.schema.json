{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "observation v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "type": "string"
    },
    "observation_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "source_version": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "metric_id": {
      "type": "string",
      "minLength": 1
    },
    "observed_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    },
    "value": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "unit": {
      "type": "string",
      "minLength": 1
    },
    "geography": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "scheme": {
              "type": "string",
              "minLength": 1
            },
            "code": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "scheme",
            "code"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "entity": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "scheme": {
              "type": "string",
              "minLength": 1
            },
            "code": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "scheme",
            "code"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "quality_status": {
      "type": "string",
      "enum": [
        "valid",
        "suspect",
        "missing"
      ]
    },
    "quality_note": {
      "type": "string",
      "minLength": 1
    },
    "source_record_reference": {
      "type": "string",
      "minLength": 1
    },
    "source_snapshot_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "transformation_version": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "observation_id",
    "source_id",
    "source_version",
    "metric_id",
    "observed_at",
    "retrieved_at",
    "value",
    "unit",
    "geography",
    "entity",
    "quality_status",
    "quality_note",
    "source_record_reference",
    "source_snapshot_sha256",
    "transformation_version"
  ],
  "additionalProperties": false
}
