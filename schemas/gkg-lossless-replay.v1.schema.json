{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GKG lossless replay v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "phase2_report_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "code_hashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "created_at": {
      "type": "string"
    },
    "batches": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "batch_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed"
            ]
          },
          "first_semantic_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "second_semantic_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "first_archive_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "second_archive_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "expected_archive_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "minLength": 1
                },
                "detail": {
                  "type": "string"
                }
              },
              "required": [
                "code",
                "detail"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "batch_id",
          "status",
          "first_semantic_sha256",
          "second_semantic_sha256",
          "first_archive_sha256",
          "second_archive_sha256",
          "expected_archive_sha256",
          "errors"
        ],
        "additionalProperties": false
      }
    },
    "passed": {
      "type": "integer",
      "minimum": 0
    },
    "failed": {
      "type": "integer",
      "minimum": 0
    },
    "semantic_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "manifest_sha256",
    "phase2_report_sha256",
    "code_hashes",
    "created_at",
    "batches",
    "passed",
    "failed",
    "semantic_sha256"
  ],
  "additionalProperties": false
}
